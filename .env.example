# Development only. Generate .env with: node scripts/init-dev-env.mjs
NODE_ENV=development
HOST=127.0.0.1
PORT=3200
PUBLIC_ORIGIN=http://127.0.0.1:3200
AUTH_MODE=web
COLLECTION_MODE=scripted
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
# One local development owner; use separate least-privilege roles in production.
POSTGRES_USER=hf_dev
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://hf_dev:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/heart_followup_v2
MIGRATION_DATABASE_URL=postgresql://hf_dev:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/heart_followup_v2
TEST_DATABASE_URL=postgresql://hf_dev:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/heart_followup_v2_test
SSH_DB_ALIAS=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional legacy mini-program authentication; not needed by the web portals.
WX_APP_ID=
WX_APP_SECRET=
ALIYUN_ASR_APP_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_ASR_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1
DASHSCOPE_API_KEY=
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang
CLINICAL_PROTOCOL_APPROVED=false
LOCAL_ASR_URL=http://127.0.0.1:3010
LOCAL_TTS_URL=http://127.0.0.1:3020
VOICE_TTS_MODE=server
WEB_BASE_PATH=/doctor/
