[Unit]
Description=Heart Follow-up Local Chinese Speech
After=network.target

[Service]
Type=simple
User=hf-web
Group=hf-web
WorkingDirectory=/opt/heart-followup-tts
Environment=TTS_MODEL_ROOT=/opt/heart-followup-tts
Environment=TTS_PORT=3020
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
StandardOutput=null
StandardError=null
ExecStart=/opt/heart-followup-tts/venv/bin/python /opt/heart-followup-tts/local_tts.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
MemoryMax=600M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
