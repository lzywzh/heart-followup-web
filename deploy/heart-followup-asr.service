[Unit]
Description=Heart Follow-up Local SenseVoice Recognition
After=network.target

[Service]
Type=simple
User=hf-web
Group=hf-web
WorkingDirectory=/opt/heart-followup-asr
Environment=ASR_MODEL_PATH=/opt/heart-followup-asr/models/asr
Environment=ASR_PORT=3010
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/heart-followup-asr/venv/bin/python -B /opt/heart-followup-asr/local_asr.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
MemoryMax=650M
StandardOutput=null
StandardError=null
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
